<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3E5F5"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:fitsSystemWindows="true"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="@color/purple_dark"
            app:expandedTitleTextAppearance="@android:style/TextAppearance.Large">

            <ImageView
                android:id="@+id/ivEventHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/banner_bg1"
                android:scaleType="centerCrop"
                android:fitsSystemWindows="true"
                app:layout_collapseMode="parallax" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="72dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Event Title"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/purple_dark"
                android:layout_alignParentTop="true" />

            <TextView
                android:id="@+id/tvDetailDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_below="@id/tvDetailTitle"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvDetailTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_below="@id/tvDetailDate"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvDetailVenue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Venue"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_below="@id/tvDetailTime"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvDetailOrganizer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Organizer"
                android:textSize="14sp"
                android:textColor="@color/teal"
                android:textStyle="bold"
                android:layout_below="@id/tvDetailVenue"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculating..."
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/amber_dark"
                android:background="@color/amber_light"
                android:padding="10dp"
                android:layout_below="@id/tvDetailOrganizer"
                android:layout_marginTop="12dp" />

            <View
                android:id="@+id/divider1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_below="@id/tvCountdown"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.5"
                android:layout_below="@id/divider1"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvPhotosLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Gallery"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/purple_dark"
                android:layout_below="@id/tvDetailDescription"
                android:layout_marginTop="20dp" />

            <View
                android:id="@+id/dividerPhotos"
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:background="@color/amber_dark"
                android:layout_below="@id/tvPhotosLabel"
                android:layout_marginTop="4dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPhotos"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_below="@id/dividerPhotos"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvSpeakersLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speakers &amp; Guests"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/purple_dark"
                android:layout_below="@id/recyclerPhotos"
                android:layout_marginTop="20dp" />

            <View
                android:id="@+id/dividerSpeakers"
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:background="@color/amber_dark"
                android:layout_below="@id/tvSpeakersLabel"
                android:layout_marginTop="4dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSpeakers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/dividerSpeakers"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false" />

        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Book Seats"
        android:textColor="@color/white"
        android:backgroundTint="@color/purple_dark"
        android:layout_gravity="bottom"
        android:layout_margin="8dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
